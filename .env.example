# ---------------------------------------------------------------------------
# Server-side only. NEVER prefix this with EXPO_PUBLIC_ — anything with that
# prefix is inlined into the app bundle and can be read out of the shipped
# binary. This key must exist only where the API route runs.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5.
# EXTRACTION_MODEL=claude-opus-5

# Server-side only, and optional. Enables speech transcription, which is how
# spoken prescriptions ("three rounds of ten") get captured — Claude has no audio
# input, so this is a separate provider.
#
# Leave it unset and imports still work: they run on video frames alone, which
# still catches anything the creator wrote on screen.
DEEPGRAM_API_KEY=

# Optional. Defaults to nova-3.
# DEEPGRAM_MODEL=nova-3

# ---------------------------------------------------------------------------
# Client-side. A URL, not a credential.
#
# Unset  -> the app runs on mock extraction: schema-valid fixtures, no server,
#           no credentials, the full flow still works end to end.
# Set    -> the app posts evidence to this endpoint and gets a real extraction.
#
# For local development against the Expo dev server:
#   EXPO_PUBLIC_EXTRACTION_ENDPOINT=http://localhost:8081/api/extract
# ---------------------------------------------------------------------------
# EXPO_PUBLIC_EXTRACTION_ENDPOINT=https://your-deployment.example.com/api/extract

# Optional. Defaults to /api/transcribe alongside the extraction endpoint, so
# you only need this if transcription is served from somewhere else.
# EXPO_PUBLIC_TRANSCRIPTION_ENDPOINT=https://your-deployment.example.com/api/transcribe

# ---------------------------------------------------------------------------
# Accounts and sync. Optional — without these the app is fully usable and
# entirely local, which is the intended default (PRD §26: try first, account
# later).
#
# Unlike the keys above, the Supabase anon key is DESIGNED to ship to clients.
# It identifies the project and authorises nothing by itself; every row is
# scoped to auth.uid() by Row Level Security. That safety is conditional on
# the RLS policies in supabase/migrations staying enabled.
# ---------------------------------------------------------------------------
# EXPO_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ---------------------------------------------------------------------------
# Analytics. Optional — without these, events go to the console in development
# and nowhere in production.
#
# The project key is WRITE-ONLY and designed to ship in clients: it can enqueue
# events, it cannot read them back. PostHog's capture format; any compatible
# collector works.
#
# Events carry an anonymous per-install id and never an email, URL or user id —
# the funnel PRD §30 cares about (import -> workout start) mostly happens before
# anyone has an account.
# ---------------------------------------------------------------------------
# EXPO_PUBLIC_ANALYTICS_ENDPOINT=https://eu.i.posthog.com/batch/
# EXPO_PUBLIC_ANALYTICS_KEY=phc_...

# ---------------------------------------------------------------------------
# Build-time, not secrets. Both only matter for native builds.
# ---------------------------------------------------------------------------

# Required to build the iOS share extension — it and the app must be signed by
# the same team to share an App Group. Omitted rather than faked when unset.
# APPLE_TEAM_ID=ABCDE12345

# Where the API routes are served from. Used for expo-router's `origin`.
# APP_ORIGIN=https://your-deployment.example.com
